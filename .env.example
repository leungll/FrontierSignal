# Copy to .env and fill in — or just run `uv run radar init`. Never commit .env.

# --- LLM provider: anthropic (Claude) or openai (OpenAI / Ollama / compatible) ---
# Optional overall: with no provider configured, filtering falls back to keywords.
LLM_PROVIDER=

# If LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=sk-ant-...

# If LLM_PROVIDER=openai (also covers Ollama and any OpenAI-compatible endpoint):
OPENAI_API_KEY=
OPENAI_BASE_URL=          # e.g. http://localhost:11434/v1 for Ollama; blank = OpenAI

# Two-tier by design: cheap model filters, strong model writes summaries.
# Defaults are Claude; override for your provider, e.g.:
#   FILTER_MODEL=gpt-4o-mini   SUMMARY_MODEL=gpt-4o
#   FILTER_MODEL=llama3.1      SUMMARY_MODEL=qwen2.5   (Ollama)
# FILTER_MODEL=
# SUMMARY_MODEL=

# --- Notification channel: lark | slack | discord | telegram | console ---
# console prints to stdout (zero config). Set the fields for your chosen channel.
NOTIFIER=lark

# Lark / Feishu custom-bot (group → Settings → Group Bots → Add Bot → Custom Bot):
LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
LARK_WEBHOOK_SECRET=      # optional: enable signature verification on the bot

# Slack incoming webhook:
SLACK_WEBHOOK_URL=
# Discord webhook:
DISCORD_WEBHOOK_URL=
# Telegram bot (talk to @BotFather for the token; chat id via @userinfobot):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Report language: zh (Chinese with English technical terms) or en ---
LANGUAGE=zh
